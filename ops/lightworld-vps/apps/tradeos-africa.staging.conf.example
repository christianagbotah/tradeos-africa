GITHUB_REPO='christianagbotah/tradeos-africa'
CANONICAL_MAIN_URL='https://github.com/christianagbotah/tradeos-africa.git'
MAIN_VERIFY_MODE='public-ls-remote'
APP_USER='lightworld'
RUNNER_USER='lwrun_tradeos'
RELEASE_ROOT='/home/lightworld/releases/tradeos-staging'
CURRENT_LINK='__SET_FROM_LIVE_VPS__'
ENV_FILE='__SET_FROM_LIVE_VPS__'
PROCESS_MANAGER='pm2'
PROCESS_NAMES='tradeos-staging-api tradeos-staging-web'
LOCAL_HEALTH_URLS='http://127.0.0.1:4036/health http://127.0.0.1:3036/'
PUBLIC_HEALTH_URLS='__SET_FROM_LIVE_VPS__'
RUNTIME_FAMILY='pnpm-node'
MIGRATION_MODE='manual'
