#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
COMMON_SH="$SCRIPT_DIR/common.sh"
if [[ ! -r "$COMMON_SH" ]]; then
  COMMON_SH="$SCRIPT_DIR/../lib/common.sh"
fi
# shellcheck source=../lib/common.sh
source "$COMMON_SH"
usage() { printf 'usage: lightworld-rollback <app> <environment>\n' >&2; }
if [[ "$#" -ne 2 ]]; then usage; exit 64; fi
app="$1"; environment="$2"
validate_identifier "$app" 'app'; validate_identifier "$environment" 'environment'
load_app_config "$app" "$environment"; require_release_config
acquire_global_lock; acquire_app_lock "$app" "$environment"

previous_sha="$(read_metadata_sha previous-release 2>/dev/null || true)"
if [[ -z "$previous_sha" ]]; then lightworld_die 'no previous successful release is recorded'; exit 1; fi
previous_dir="${RELEASE_ROOT}/${previous_sha}"
if [[ ! -d "$previous_dir" ]]; then lightworld_die 'recorded previous release directory is missing'; exit 1; fi
current_sha="$(read_metadata_sha last-successful-release 2>/dev/null || true)"
current_target=''
if [[ -L "$CURRENT_LINK" ]]; then current_target="$(realpath -- "$CURRENT_LINK" 2>/dev/null || true)"; fi

activate_release_target "$previous_dir"
restart_configured_processes
if ! verify_configured_health; then
  if [[ -n "$current_target" && -d "$current_target" ]]; then
    activate_release_target "$current_target" || true
    restart_configured_processes || true
  fi
  lightworld_die 'rollback health verification failed'
  exit 1
fi
write_metadata_sha last-successful-release "$previous_sha"
if [[ -n "$current_sha" && "$current_sha" != "$previous_sha" ]]; then write_metadata_sha previous-release "$current_sha"; fi
printf 'rolled_back_to=%s\n' "$previous_sha"
