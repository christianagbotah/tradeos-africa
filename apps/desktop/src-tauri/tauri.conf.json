{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradeOS Africa",
  "version": "0.0.1",
  "identifier": "com.lightworldtech.tradeos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TradeOS Africa",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Offline-first business operating system",
    "longDescription": "TradeOS Africa desktop client for Windows and macOS."
  }
}
